unused","saveCart","items","setItem","stringify","calcTotals","itemsPrice","reduce","sum","i","price","qty","shippingPrice","taxPrice","Math","round","totalItems","cartSlice","name","initialState","_objectSpread","reducers","addToCart","state","_ref","payload","existing","find","_id","countInStock","push","Object","assign","removeFromCart","_ref2","filter","updateQty","_ref3","_ref3$payload","id","item","clearCart","removeItem","_cartSlice$actions","actions","reducer"],"sources":["C:/Users/DELL/Downloads/saleswebsite_fixed/saleswebsite/frontend/src/features/cart/cartSlice.js"],"sourcesContent":["import { createSlice } from '@reduxjs/toolkit'\n\nconst loadCart = () => {\n  try { return JSON.parse(localStorage.getItem('cart')) || [] } catch { return [] }\n}\n\nconst saveCart = (items) => localStorage.setItem('cart', JSON.stringify(items))\n\nconst calcTotals = (items) => ({\n  itemsPrice: items.reduce((sum, i) => sum + i.price * i.qty, 0),\n  shippingPrice: items.reduce((sum, i) => sum + i.price * i.qty, 0) > 500 ? 0 : 49,\n  taxPrice: Math.round(items.reduce((sum, i) => sum + i.price * i.qty, 0) * 0.05),\n  totalItems: items.reduce((sum, i) => sum + i.qty, 0),\n})\n\nconst cartSlice = createSlice({\n  name: 'cart',\n  initialState: {\n    items: loadCart(),\n    ...calcTotals(loadCart()),\n  },\n  reducers: {\n    addToCart: (state, { payload }) => {\n      const existing = state.items.find((i) => i._id === payload._id)\n      if (existing) {\n        if (existing.qty < payload.countInStock) existing.qty += 1\n      } else {\n        state.items.push({ ...payload, qty: 1 })\n      }\n      Object.assign(state, calcTotals(state.items))\n      saveCart(state.items)\n    },\n    removeFromCart: (state, { payload }) => {\n      state.items = state.items.filter((i) => i._id !== payload)\n      Object.assign(state, calcTotals(state.items))\n      saveCart(state.items)\n    },\n    updateQty: (state, { payload: { id, qty } }) => {\n      const item = state.items.find((i) => i._id === id)\n      if (item) item.qty = qty\n      Object.assign(state, calcTotals(state.items))\n      saveCart(state.items)\n    },\n    clearCart: (state) => {\n      state.items = []\n      Object.assign(state, calcTotals([]))\n      localStorage.removeItem('cart')\n    },\n  },\n})\n\nexport const { addToCart, removeFromCart, updateQty, clearCart } = cartSlice.actions\nexport default cartSlice.reducer\n"],"mappings":"qJAAA,OAASA,WAAW,KAAQ,kBAAkB,CAE9C,KAAM,CAAAC,QAAQ,CAAGA,CAAA,GAAM,CACrB,GAAI,CAAE,MAAO,CAAAC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,MAAM,CAAC,CAAC,EAAI,EAAE,CAAC,CAAE,MAAAC,OAAA,CAAM,CAAE,MAAO,EAAE,CAAC,CAClF,CAAC,CAED,KAAM,CAAAC,QAAQ,CAAIC,KAAK,EAAKJ,YAAY,CAACK,OAAO,CAAC,MAAM,CAAEP,IAAI,CAACQ,SAAS,CAACF,KAAK,CAAC,CAAC,CAE/E,KAAM,CAAAG,UAAU,CAAIH,KAAK,GAAM,CAC7BI,UAAU,CAAEJ,KAAK,CAACK,MAAM,CAAC,CAACC,GAAG,CAAEC,CAAC,GAAKD,GAAG,CAAGC,CAAC,CAACC,KAAK,CAAGD,CAAC,CAACE,GAAG,CAAE,CAAC,CAAC,CAC9DC,aAAa,CAAEV,KAAK,CAACK,MAAM,CAAC,CAACC,GAAG,CAAEC,CAAC,GAAKD,GAAG,CAAGC,CAAC,CAACC,KAAK,CAAGD,CAAC,CAACE,GAAG,CAAE,CAAC,CAAC,CAAG,GAAG,CAAG,CAAC,CAAG,EAAE,CAChFE,QAAQ,CAAEC,IAAI,CAACC,KAAK,CAACb,KAAK,CAACK,MAAM,CAAC,CAACC,GAAG,CAAEC,CAAC,GAAKD,GAAG,CAAGC,CAAC,CAACC,KAAK,CAAGD,CAAC,CAACE,GAAG,CAAE,CAAC,CAAC,CAAG,IAAI,CAAC,CAC/EK,UAAU,CAAEd,KAAK,CAACK,MAAM,CAAC,CAACC,GAAG,CAAEC,CAAC,GAAKD,GAAG,CAAGC,CAAC,CAACE,GAAG,CAAE,CAAC,CACrD,CAAC,CAAC,CAEF,KAAM,CAAAM,SAAS,CAAGvB,WAAW,CAAC,CAC5BwB,IAAI,CAAE,MAAM,CACZC,YAAY,CAAAC,aAAA,EACVlB,KAAK,CAAEP,QAAQ,CAAC,CAAC,EACdU,UAAU,CAACV,QAAQ,CAAC,CAAC,CAAC,CAC1B,CACD0B,QAAQ,CAAE,CACRC,SAAS,CAAEA,CAACC,KAAK,CAAAC,IAAA,GAAkB,IAAd,CAAAC,OAAO,CAAAD,IAAA,CAAPC,OAAO,CAC1B,KAAM,CAAAC,QAAQ,CAAGH,KAAK,CAACrB,KAAK,CAACyB,IAAI,CAAElB,CAAC,EAAKA,CAAC,CAACmB,GAAG,GAAKH,OAAO,CAACG,GAAG,CAAC,CAC/D,GAAIF,QAAQ,CAAE,CACZ,GAAIA,QAAQ,CAACf,GAAG,CAAGc,OAAO,CAACI,YAAY,CAAEH,QAAQ,CAACf,GAAG,EAAI,CAAC,CAC5D,CAAC,IAAM,CACLY,KAAK,CAACrB,KAAK,CAAC4B,IAAI,CAAAV,aAAA,CAAAA,aAAA,IAAMK,OAAO,MAAEd,GAAG,CAAE,CAAC,EAAE,CAAC,CAC1C,CACAoB,MAAM,CAACC,MAAM,CA